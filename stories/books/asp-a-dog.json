   "img": "img/asp-a-dog/02.webp",
   "text": "There was a man with his one dog."
  },
  {
   "img": "img/asp-a-dog/03.webp",
   "text": "He loved his dog so much."
  },
  {
   "img": "img/asp-a-dog/04.webp",
   "text": "It was hard working and it used to go to the market to buy meat."
  },
  {
   "img": "img/asp-a-dog/05.webp",
   "text": "fetching water from the well."
  },
  {
   "img": "img/asp-a-dog/06.webp",
   "text": "Guarding every thing at home."
  },
  {
   "img": "img/asp-a-dog/07.webp",
   "text": "One day the man thanked his dog in a special way for being faithful."
  },
  {
   "img": "img/asp-a-dog/08.webp",
   "text": "The dog became so happy and it continued working hard."
  }
