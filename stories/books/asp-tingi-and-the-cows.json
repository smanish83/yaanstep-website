{
 "id": "asp-tingi-and-the-cows",
 "title": "Tingi and the cows",
 "pages": [
  {
   "img": "img/asp-tingi-and-the-cows/02.webp",
   "text": "Tingi lived with his grandmother."
  },
  {
   "img": "img/asp-tingi-and-the-cows/03.webp",
   "text": "He used to look after the cows with her."
  },
  {
   "img": "img/asp-tingi-and-the-cows/04.webp",
   "text": "One day the soldiers came."
  },
  {
   "img": "img/asp-tingi-and-the-cows/05.webp",
   "text": "They took the cows away."
  },
  {
   "img": "img/asp-tingi-and-the-cows/06.webp",
   "text": "Tingi and his grandmother ran away and hid."
  },
  {
   "img": "img/asp-tingi-and-the-cows/07.webp",
   "text": "They hid in the bush until night."
  },
  {
   "img": "img/asp-tingi-and-the-cows/08.webp",
   "text": "Then the soldiers came back."
  },
  {
   "img": "img/asp-tingi-and-the-cows/09.webp",
   "text": "Grandmother hid Tingi under the leaves."
  },
  {
   "img": "img/asp-tingi-and-the-cows/10.webp",
   "text": "One of the soldiers put his foot right on him, but he kept quiet."
  },
  {
   "img": "img/asp-tingi-and-the-cows/11.webp",
   "text": "When it was safe, Tingi and his grandmother came out."
  },
  {
   "img": "img/asp-tingi-and-the-cows/12.webp",
   "text": "They crept home very quietly."
  }
 ],
